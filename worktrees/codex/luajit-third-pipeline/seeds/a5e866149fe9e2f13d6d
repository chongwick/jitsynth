<?php

try {
    sprintf('%$s, %2$s %1$s', "a", "b");
} catch (ValueError $e) {
    echo $e->getMessage(), "\n";
}

try {
    sprintf('%3$s, %2$s %1$s', "a", "b");
} catch (ArgumentCountError $e) {
    echo $e->getMessage(), "\n";
}

try {
    sprintf('%2147483648$s, %2$s %1$s', "a", "b");
} catch (ValueError $e) {
    echo $e->getMessage(), "\n";
}

?>