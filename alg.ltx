\begin{algorithm}[t]
\scriptsize
\SetAlgoLined
\DontPrintSemicolon
\caption{Constraint-Guided Synthesis}
\label{alg:synthesis}
\KwIn{\joc{} $T$, corpus index $\mathcal{I}$, file cache $\mathcal{F}$, dependency cache $\mathcal{D}$, mode \textit{strict}}
\KwOut{PHP source string}

\SetKwFunction{FSynth}{Synthesize}
\SetKwFunction{FRegion}{SynthRegion}
\SetKwFunction{FFill}{FillDataSlot}
\SetKwFunction{FEmit}{EmitWrapper}
\SetKwProg{Fn}{Function}{:}{}

\Fn{\FSynth{$T$, $\mathcal{I}$, $\mathcal{F}$, $\mathcal{D}$, \textit{strict}}}{
    hoisted $\gets$ [~]\;
    body $\gets$ [``\texttt{<?php}'']\;
    \ForEach{element $e$ in $T[1:]$}{
        \uIf{$e$ is a nested list (region)}{
            $(h, lines) \gets$ \FRegion{$e$, $\mathcal{I}$, $\mathcal{F}$, $\mathcal{D}$, 0, \textit{strict}}\;
            hoisted.extend($h$)\;
            body.extend($lines$)\;
        }
        \ElseIf{$e$ is DataComp}{
            $(h, code, \_, \_) \gets$ \FFill{$e$, $\mathcal{I}$, $\mathcal{F}$, $\mathcal{D}$, \textit{strict}}\;
            hoisted.extend($h$)\;
            body.append($code$)\;
        }
    }
    \KwRet Deduplicate(hoisted) + body\;
}

\Fn{\FRegion{$R$, $\mathcal{I}$, $\mathcal{F}$, $\mathcal{D}$, depth, \textit{strict}}}{
    $c \gets R[0]$\tcp*{ControlComp (comp\_type, trip\_count)}
    lines $\gets$ [\FEmit{$c$, depth, \textit{strict}}]\;
    hoisted $\gets$ [~]\;
    \ForEach{element $e$ in $R[1:]$}{
        \uIf{$e$ is a nested list}{
            $(h, sub) \gets$ \FRegion{$e$, $\mathcal{I}$, $\mathcal{F}$, $\mathcal{D}$, depth+1, \textit{strict}}\;
            hoisted.extend($h$); lines.extend($sub$)\;
        }
        \ElseIf{$e$ is DataComp}{
            $(h, code, \_, \_) \gets$ \FFill{$e$, $\mathcal{I}$, $\mathcal{F}$, $\mathcal{D}$, \textit{strict}}\;
            hoisted.extend($h$)\;
            lines.append(Indent(code, depth+1))\;
        }
    }
    lines.append(EmitClose($c$, depth))\;
    \KwRet (hoisted, lines)\;
}

\Fn{\FFill{$e$, $\mathcal{I}$, $\mathcal{F}$, $\mathcal{D}$, \textit{strict}}}{
    $C \gets \bigcup_{d \,\in\, \text{Desc}(e.\text{comp\_type})} \mathcal{I}[d]$\tcp*{node-type candidates}
    \If{\textit{strict} \textbf{and} $e.\text{type} \notin \{\texttt{mixed}, \bot\}$}{
        $C' \gets \{\, x \in C : x.\text{value\_type} = e.\text{type} \,\}$\tcp*{type-directed}
        \lIf{$C' \neq \emptyset$}{$C \gets C'$}
    }
    entry $\gets$ RandomChoice($C$)\;
    slice $\gets$ DependencySlice(entry, $\mathcal{F}$, $\mathcal{D}$)\;
    $(hoist, inline) \gets$ Partition(slice)\;
    \KwRet $(hoist, inline, entry.\text{defs}, entry.\text{free\_uses})$\;
}

\Fn{\FEmit{$c$, depth, \textit{strict}}}{
    \If{$c.\text{comp\_type}$ is a loop}{
        \eIf{\textit{strict} \textbf{and} $c.\text{trip\_count} \neq \bot$}{
            bound $\gets c.\text{trip\_count}$\tcp*{honor JOC trip count}
        }{
            bound $\gets$ \textsc{Default}\;
        }
        \KwRet CountedLoop($c.\text{comp\_type}$, bound, depth)\;
    }
    \KwRet Header($c.\text{comp\_type}$, depth)\;
}
\end{algorithm}
