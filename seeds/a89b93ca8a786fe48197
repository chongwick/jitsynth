<?php

try {
    var_dump(strncmp("test ", "e", -1));
} catch (\ValueError $e) {
    echo $e->getMessage() . \PHP_EOL;
}
var_dump(strncmp("test ", "e", 10));
var_dump(strncmp("test ", "e", 0));

try {
    var_dump(strncasecmp("test ", "E", -1));
} catch (\ValueError $e) {
    echo $e->getMessage() . \PHP_EOL;
}
var_dump(strncasecmp("test ", "E", 10));
var_dump(strncasecmp("test ", "E", 0));

?>