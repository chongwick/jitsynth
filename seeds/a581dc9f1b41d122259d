<?php
$reflection = new ReflectionClass('\DateTime');

$mutable = $reflection->newInstanceWithoutConstructor();
try {
	$immutable = \DateTimeImmutable::createFromMutable($mutable);
} catch (Throwable $t) {
	echo $t->getMessage(), "\n";
}


