<?php
$im = imagecreatetruecolor(1, 1);
try {
	imagescale($im, 1, 1, -10);
} catch (\ValueError $e) {
	echo $e->getMessage() . PHP_EOL;
}
try {
	imagescale($im, 0, 1, 0);
} catch (\ValueError $e) {
	echo $e->getMessage() . PHP_EOL;
}
try {
	imagescale($im, 1, 0, 0);
} catch (\ValueError $e) {
	echo $e->getMessage() . PHP_EOL;
}
imagescale($im, 1, 1, IMG_BICUBIC_FIXED);
echo "OK";
?>